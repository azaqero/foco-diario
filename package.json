{
  "name": "foco-diario",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Rewrite the feed as a finite, text-only newspaper front page.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome",
