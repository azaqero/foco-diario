    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}
